<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws every screen; the window background only shows during launch,
         so it matches the navy splash to avoid a white flash. -->
    <style name="Theme.WanderAI" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/navy_deep</item>
        <item name="colorPrimary">@color/navy_deep</item>
        <item name="colorAccent">@color/teal_brand</item>
    </style>
</resources>
